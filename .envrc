export NIXPKGS_ALLOW_UNFREE=1
use nix

export NPM_CONFIG_USERCONFIG=$HOME/.npmrc-nix
export PATH=~/.npm-packages/bin:$PATH
export NODE_PATH=~/.npm-packages/lib/node_modules

gh auth switch --user well-architected-cloud

export GH_TOKEN=$(gh auth token --user well-architected-cloud)

git config --global user.email "sascha.fedorenko@the-well-architected-cloud.com"
git config --global user.name "Sascha Fedorenko"
